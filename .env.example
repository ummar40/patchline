# Copy to .env and fill in the blanks. Never commit .env.
# Values shown here are local-development defaults or documented examples, not secrets.

# ---- Shared by the web app and the worker ----
NODE_ENV=development
LOG_LEVEL=info

# Public base URL of the web app. Used for OAuth redirects and links in pull requests.
APP_URL=http://localhost:3000

# Matches docker-compose.yml. Passwords in these URLs are scrubbed from every log line and job
# event wherever they appear, so never use an ordinary word as a password.
DATABASE_URL=postgresql://patchline:local-dev-password@localhost:5432/patchline
REDIS_URL=redis://localhost:6379

JOB_QUEUE_NAME=maintenance-jobs

# GitHub App credentials. Run `npm run github:create-app` to register an app and fill
# these in automatically, or see docs/github-app-setup.md for the manual steps.
GITHUB_APP_ID=
# PEM contents with \n escapes, or the whole PEM base64-encoded.
GITHUB_APP_PRIVATE_KEY=
# Override only for GitHub Enterprise Server.
# GITHUB_API_URL=https://api.github.com
# GITHUB_WEB_URL=https://github.com

# ---- Web app only ----
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Optional. Without it the webhook endpoint rejects every delivery.
GITHUB_WEBHOOK_SECRET=

SESSION_TTL_HOURS=168
MAX_ACTIVE_JOBS_PER_USER=3

# ---- Worker only ----
OPENAI_API_KEY=
# OPENAI_BASE_URL=
OPENAI_MODEL=gpt-6-astra
# One of: none, minimal, low, medium, high, xhigh, max (subject to model support).
OPENAI_REASONING_EFFORT=high
OPENAI_MAX_OUTPUT_TOKENS=32000
OPENAI_REQUEST_TIMEOUT_SECONDS=900
OPENAI_MAX_RETRIES=3

# USD per million tokens, used only to estimate job cost. Leave blank to skip estimates.
# Check the provider's current price list before relying on these numbers.
MODEL_PRICE_INPUT_PER_MTOK=10
MODEL_PRICE_CACHED_INPUT_PER_MTOK=1
MODEL_PRICE_OUTPUT_PER_MTOK=50

AGENT_MAX_TURNS=120
AGENT_MAX_REPAIR_ITERATIONS=3
AGENT_MAX_JOB_TOKENS=6000000
AGENT_MAX_TOOL_OUTPUT_CHARS=24000
JOB_TIMEOUT_SECONDS=3600

WORKER_CONCURRENCY=1
WORKER_SHUTDOWN_GRACE_SECONDS=30
WORKER_RECONCILE_INTERVAL_SECONDS=30

# Build with `npm run sandbox:build`.
SANDBOX_IMAGE=patchline-sandbox:local
# Owner label for sandbox resources. Deployments sharing one Docker host must use different
# values. Defaults to JOB_QUEUE_NAME.
# SANDBOX_NAMESPACE=
SANDBOX_DOCKER_BINARY=docker
# Optional hardened runtime, for example runsc (gVisor).
# SANDBOX_RUNTIME=
# Docker network used only for steps that need outbound access (clone, install, push).
SANDBOX_EGRESS_NETWORK=bridge
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_MB=4096
SANDBOX_PIDS_LIMIT=512
SANDBOX_TMPFS_MB=1024
SANDBOX_COMMAND_TIMEOUT_SECONDS=900
SANDBOX_INSTALL_TIMEOUT_SECONDS=1200

GIT_CLONE_DEPTH=50
GIT_BRANCH_PREFIX=maintenance
GIT_COMMIT_AUTHOR_NAME=
GIT_COMMIT_AUTHOR_EMAIL=
CHANGESET_MAX_FILES=40
CHANGESET_MAX_PATCH_BYTES=400000
