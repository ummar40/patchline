{
  "name": "patchline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker/main.ts",
    "build": "next build",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "next start",
    "start:worker": "node --env-file-if-exists=.env dist/worker/main.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:source": "node scripts/check-source.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "sandbox:build": "node scripts/build-sandbox-image.mjs",
    "github:create-app": "node scripts/create-github-app.mjs",
    "verify": "npm run format:check && npm run check:source && npm run lint && npm run typecheck && npm run test && npm run build && npm run build:worker",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "^6.3.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "octokit": "^5.0.5",
    "openai": "^7.19.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.3.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.8",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
